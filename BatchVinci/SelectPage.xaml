<Page
    x:Class="BatchVinci.SelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BatchVinci">

    <Grid Padding="24,8,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PickButton" Click="Pick_Click" Content="Scegli progetto DRP…" VerticalAlignment="Bottom" />
            <TextBox x:Name="NameBox" Grid.Column="1" Header="Nome configurazione" TextChanged="NameBox_TextChanged" />
        </Grid>
        <TextBlock x:Name="DrpPathText" Grid.Row="2" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />

        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="FoundHeader" Text="Spunta le label da gestire come parametri" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView Grid.Row="1" SelectionMode="None" ItemsSource="{x:Bind Items}"
                      BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TextItem">
                        <CheckBox IsChecked="{x:Bind IsParameter, Mode=TwoWay}" Margin="4,2">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Preview}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Where}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" />
            <Button x:Name="SaveButton" Grid.Column="1" VerticalAlignment="Top" IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" Click="Save_Click" Content="Salva configurazione" />
        </Grid>
    </Grid>
</Page>
