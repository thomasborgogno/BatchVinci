<Window
    x:Class="BatchVinci.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BatchVinci">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button x:Name="BackButton" Margin="12,12,0,0" Padding="10,6" Visibility="Collapsed"
                Click="BackButton_Click" AutomationProperties.Name="Indietro">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                <TextBlock Text="Indietro" />
            </StackPanel>
        </Button>
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
